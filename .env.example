PORT=3000
DATA_FILE=./data/store.json
PD_STRICT_MODE=true
PUBLIC_SITE_ENABLED=false
# Разрешенные Host-заголовки. Не добавляйте произвольные домены.
ALLOWED_HOSTS=tursbezhimnamore.ru,www.tursbezhimnamore.ru,test.tursbezhimnamore.ru,127.0.0.1,localhost
# true допустимо только когда порт 3000 доступен исключительно через доверенный локальный Nginx.
TRUST_PROXY=true
# Логин: минимум 12 символов. Пароль: минимум 32 случайных символа.
ADMIN_USERNAME=replace_with_a_long_random_login
ADMIN_PASSWORD=replace_with_at_least_32_random_characters
# Отдельный случайный секрет минимум 32 символа для HMAC-хешей IP и User-Agent
CONSENT_EVIDENCE_SECRET=replace_with_a_long_random_secret

VK_GROUP_ID=
VK_CONFIRMATION_CODE=
VK_CALLBACK_SECRET=
VK_GROUP_TOKEN=
VK_API_VERSION=5.199
# Руководитель должен сначала написать сообществу, затем сюда указывается его VK user_id
NOTIFY_VK_PEER_ID=
UON_API_KEY=
UON_SOURCE=ВКонтакте
UON_COMMENT_FIELD=note
UON_MANAGER_ID=3
UON_TIMEOUT_MS=10000
UON_RETRIES=3

# Российский SMTP вместо Resend
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=
NOTIFY_RETRIES=2

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=
MAX_API_URL=https://platform-api2.max.ru
# Ссылка на аккаунт менеджера в MAX для кнопки «Написать в MAX»
MANAGER_MAX_URL=

# XML API Турвизора: авторизация идет через authlogin (email кабинета) и authpass (пароль API)
TOURVISOR_SEARCH_ENDPOINT=https://tourvisor.ru/xml/search.php
TOURVISOR_LOGIN=
TOURVISOR_PASSWORD=
# Совместимость: если пароль не задан отдельно, используется TOURVISOR_API_TOKEN
TOURVISOR_API_TOKEN=
# Необязательно: город вылета по умолчанию (код Турвизора), если подписчик его не указал
TOURVISOR_DEFAULT_CITY=
AGENCY_TOUR_SEARCH_URL=https://tursbezhimnamore.ru/tours
HOT_TOURS_HOURS=9,14,19
HOT_TOURS_LIMIT=3
